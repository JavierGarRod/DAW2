<%- include('partials/cabecera') %>

<h1><%= titulo %></h1>
<p class="total">Total: <%= libros.length %> <%= libros.length === 1 ? 'libro' : 'libros' %></p>

<% if (libros.length === 0) { %>
  <p class="vacio">No hay libros que mostrar</p>
<% } else { %>
  <table>
    <thead>
      <tr>
        <th>Título</th>
        <th>Autor</th>
        <th>Año</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      <% libros.forEach(libro => { %>
        <tr>
          <td>
            <%= libro.titulo %>
            <% if (libro.anio < 2000) { %><span class="clasico">(clásico)</span><% } %>
          </td>
          <td><%= libro.autor %></td>
          <td><%= libro.anio %></td>
          <td>
            <% if (libro.disponible) { %>
              <span class="estado disponible">Disponible</span>
            <% } else { %>
              <span class="estado prestado">Prestado</span>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('partials/pie') %>
